# Compile-check additions to the locked OpenWrt generic + ThorOS target config.
# These enable the package-selected network objects without building packages.
# This is deliberately NOT advertised as the complete shipping firmware config.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_NET_SWITCHDEV=y
CONFIG_NET_CLS_ACT=y
CONFIG_SKB_EXTENSIONS=y
CONFIG_PPP=y
CONFIG_PPPOE=y
CONFIG_OF=y
CONFIG_I2C=y
CONFIG_PHYLIB=y
CONFIG_ARCH_RTL9617C=y
CONFIG_RTL9617C_XRAM_ETH=y
CONFIG_RTL9617C_BOSA=y
CONFIG_RTL9617C_PON=y
CONFIG_WERROR=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_RUST is not set
