# Official A53 package installation: trust and target-only runtime libraries.
CONFIG_PACKAGE_openwrt-keyring=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y

# Keep the full wired LuCI administration surface without the luci metapackage.
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# WireGuard and TUN remain available for the router and proxy workloads.
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y

# Native nftables transparent proxy support, without legacy iptables rules.
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
