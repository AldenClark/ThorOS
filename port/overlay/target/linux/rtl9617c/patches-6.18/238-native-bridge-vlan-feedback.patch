+/* The first IVL backend preserves a single C tag byte-for-byte.  PVID
+ * insertion, priority-tag translation and egress untag are separate packet
+ * editing contracts, not consequences of finding a VLAN membership row.
+ * RTNL owns VLAN lifetimes; the switch guard fences lockless state changes.
+ */
+bool br_rtl9617c_l2_vlan_port_eligible(const struct net_device *dev)
+{
+#if IS_ENABLED(CONFIG_BRIDGE_VLAN_FILTERING)
+	const struct net_bridge_vlan_group *vg;
+	const struct net_bridge_vlan *v;
+	const struct net_bridge_port *p;
+	bool member = false;
+
+	ASSERT_RTNL();
+	if (!br_rtl9617c_l2_port_eligible(dev))
+		return false;
+	p = br_port_get_rtnl(dev);
+	if (!br_opt_get(p->br, BROPT_VLAN_ENABLED) ||
+	    p->br->vlan_proto != htons(ETH_P_8021Q))
+		return false;
+	vg = nbp_vlan_group(p);
+	if (!vg || br_get_pvid(vg))
+		return false;
+	list_for_each_entry(v, &vg->vlan_list, vlist) {
+		const struct net_bridge_vlan *global;
+
+		if (!br_vlan_should_use(v))
+			continue;
+		global = v->brvlan;
+		if (!v->vid || v->vid >= VLAN_VID_MASK ||
+		    (v->flags & (BRIDGE_VLAN_INFO_UNTAGGED | BRIDGE_VLAN_INFO_PVID)) ||
+		    br_vlan_get_state(v) != BR_STATE_FORWARDING ||
+		    (v->priv_flags & BR_VLFLAG_NEIGH_SUPPRESS_ENABLED) ||
+		    rcu_access_pointer(v->tinfo.tunnel_dst) || v->tinfo.tunnel_id ||
+		    !global || READ_ONCE(global->msti) ||
+		    br_vlan_get_state(global) != BR_STATE_FORWARDING)
+			return false;
+		/* A global context need not have BRENTRY: that flag authorizes
+		 * host participation, not transit between member bridge ports. */
+		member = true;
+	}
+	return member;
+#else
+	return false;
+#endif
+}
+EXPORT_SYMBOL_GPL(br_rtl9617c_l2_vlan_port_eligible);
