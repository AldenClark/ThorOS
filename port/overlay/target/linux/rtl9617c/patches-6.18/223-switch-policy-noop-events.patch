From: ThorOS maintainers
Subject: [PATCH] net: do not withdraw switch flows for no-op device updates

Only gate flag bits that __dev_change_flags can actually change, using
gflags for the userspace promisc/allmulti requests. Volatile link-state
bits in an rtnetlink read/modify/write do not alter forwarding policy.

Validate an MTU request before entering the policy transaction. An equal,
out-of-range or absent-device request has no publication to fence. Actual
changes remain gated across the pre-change notifier, driver call and any
rollback, including their failure paths.

--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -9791,7 +9791,12 @@
 int netif_change_flags(struct net_device *dev, unsigned int flags,
 		       struct netlink_ext_ack *extack)
 {
-	CLASS(rtl9617c_switch_policy, policy)(dev);
+	CLASS(rtl9617c_switch_policy, policy)(
+		((flags ^ dev->flags) &
+		 (IFF_UP | IFF_DEBUG | IFF_NOTRAILERS | IFF_NOARP |
+		  IFF_DYNAMIC | IFF_MULTICAST | IFF_PORTSEL | IFF_AUTOMEDIA)) ||
+		((flags ^ dev->gflags) & (IFF_PROMISC | IFF_ALLMULTI)) ?
+		dev : NULL);
 
 	int ret;
 	unsigned int changes, old_flags = dev->flags, old_gflags = dev->gflags;
@@ -9847,8 +9852,6 @@
 int netif_set_mtu_ext(struct net_device *dev, int new_mtu,
 		      struct netlink_ext_ack *extack)
 {
-	CLASS(rtl9617c_switch_policy, policy)(dev);
-
 	int err, orig_mtu;
 
 	netdev_ops_assert_locked(dev);
@@ -9863,6 +9866,8 @@
 	if (!netif_device_present(dev))
 		return -ENODEV;
 
+	CLASS(rtl9617c_switch_policy, policy)(dev);
+
 	err = call_netdevice_notifiers(NETDEV_PRECHANGEMTU, dev);
 	err = notifier_to_errno(err);
 	if (err)
--- a/net/bridge/br_if.c
+++ b/net/bridge/br_if.c
@@ -573,6 +573,7 @@
 int br_add_if(struct net_bridge *br, struct net_device *dev,
 	      struct netlink_ext_ack *extack)
 {
+	CLASS(rtl9617c_switch_policy, port_policy)(dev);
 	CLASS(rtl9617c_switch_policy, policy)(br->dev);
 
 	struct net_bridge_port *p;
