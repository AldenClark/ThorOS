+/* All channel writers hold BOTH PPP locks. This makes begin/end pairs
+ * non-nesting even when different channels of one unit change concurrently.
+ * The gate only writes admission state/queues work; it never takes RTNL,
+ * the FE mutex or waits for hardware work while the PPP locks are held. */
+static struct net *ppp_flow_change_begin(struct ppp *ppp)
+{
+	struct net *policy;
+
+	lockdep_assert_held(&ppp->wlock);
+	lockdep_assert_held(&ppp->rlock);
+	policy = rtl9617c_switch_policy_begin(ppp->dev);
+	if (atomic_read(&ppp->dev->ppp_channel_generation))
+		atomic_inc_return(&ppp->dev->ppp_channel_generation);
+	return policy;
+}
+
+static void ppp_flow_change_end(struct ppp *ppp, struct net *policy)
+{
+	lockdep_assert_held(&ppp->wlock);
+	lockdep_assert_held(&ppp->rlock);
+	/* Zero after wrap is permanent: never authorize an old cookie again. */
+	if (atomic_read(&ppp->dev->ppp_channel_generation))
+		atomic_inc_return(&ppp->dev->ppp_channel_generation);
+	rtl9617c_switch_policy_end(policy);
+}
+
+/* chan_sem write-held by unregister. Match the documented channel.upl ->
+ * PPP locks -> channel.downl order. Gate BEFORE the first published NULL,
+ * not only later when disconnect removes the channel list entry. */
+static void ppp_channel_unpublish(struct channel *pch)
+{
+	struct net *policy = NULL;
+	struct ppp *ppp;
+	bool changing;
+
+	spin_lock(&pch->upl);
+	ppp = rcu_dereference_protected(pch->ppp, lockdep_is_held(&pch->upl));
+	if (ppp)
+		ppp_lock(ppp);
+	spin_lock_bh(&pch->downl);
+	changing = ppp && pch->chan;
+	if (changing)
+		policy = ppp_flow_change_begin(ppp);
+	WRITE_ONCE(pch->chan, NULL);
+	if (changing)
+		ppp_flow_change_end(ppp, policy);
+	spin_unlock_bh(&pch->downl);
+	if (ppp)
+		ppp_unlock(ppp);
+	spin_unlock(&pch->upl);
+}
+
