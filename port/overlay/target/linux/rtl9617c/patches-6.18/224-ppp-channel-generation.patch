+static void nf_flow_offload_ppp_release(struct flow_cls_offload *cls)
+{
+	unsigned int dir;
+
+	for (dir = 0; dir < ARRAY_SIZE(cls->ppp_paths); dir++) {
+		if (cls->ppp_paths[dir].dev)
+			dev_put(cls->ppp_paths[dir].dev);
+		cls->ppp_paths[dir].dev = NULL;
+		cls->ppp_paths[dir].cookie = 0;
+	}
+}
+
+/* A held dst can replace dst->dev with blackhole_netdev during unregister.
+ * Take an independent, RCU-safe device reference for each synchronous
+ * callback; the driver must not retain these borrowed pointers. */
+static bool nf_flow_offload_ppp_prepare(struct flow_cls_offload *cls,
+					struct flow_offload *flow)
+{
+	unsigned int dir;
+	bool valid = true;
+
+	if (flow->type != NF_FLOW_OFFLOAD_ROUTE)
+		return true;
+	rcu_read_lock();
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+		struct net_device *dev;
+
+		if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT)
+			continue;
+		if (!tuple->out.route_dst) {
+			valid = false;
+			break;
+		}
+		dev = READ_ONCE(tuple->out.route_dst->dev);
+		if (!tuple->out.ppp_cookie && dev->type != ARPHRD_PPP)
+			continue;
+		if (dev->type != ARPHRD_PPP ||
+		    !netdev_ppp_path_valid(dev, tuple->out.ppp_cookie)) {
+			valid = false;
+			break;
+		}
+		dev_hold(dev);
+		cls->ppp_paths[dir].dev = dev;
+		cls->ppp_paths[dir].cookie = tuple->out.ppp_cookie;
+	}
+	rcu_read_unlock();
+	if (!valid)
+		nf_flow_offload_ppp_release(cls);
+	return valid;
+}
