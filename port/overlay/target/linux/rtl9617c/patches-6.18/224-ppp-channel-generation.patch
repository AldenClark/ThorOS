+	/* NF flowtable REPLACE only: held through the driver callback. Both
+	 * directions depend on the same connection's PPP channel lifetime. */
+	struct {
+		struct net_device *dev;
+		u32 cookie;
+	} ppp_paths[2];
+};
+
+/* Call under the hardware owner's configuration mutex, before installation.
+ * A later PPP mutation synchronously closes admission; its rearm worker
+ * takes that same mutex and withdraws the old generation before reopening. */
+static inline bool flow_cls_offload_ppp_valid(const struct flow_cls_offload *cls)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cls->ppp_paths); i++) {
+		if (!cls->ppp_paths[i].dev && !cls->ppp_paths[i].cookie)
+			continue;
+		if (!cls->ppp_paths[i].dev ||
+		    !netdev_ppp_path_valid(cls->ppp_paths[i].dev,
+					  cls->ppp_paths[i].cookie))
+			return false;
+	}
+	return true;
+}
 
