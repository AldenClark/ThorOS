From: Codex <codex@localhost>
Subject: [PATCH] netfilter: serialize flowtable work admission and retirement

Do not queue new work once hardware deletion has started. Claim PENDING
before checking DYING, and retain the same gate through GC unlink and RCU
free so stale readers cannot hand a retired flow to an asynchronous worker.
Use an acquire read to pair with the upstream worker's release barrier.

Signed-off-by: Codex <codex@localhost>
---
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -640,9 +640,10 @@
 	bool teardown;
 
-	if (test_bit(NF_FLOW_PENDING, &flow->flags))
+	/* Worker writes are visible once PENDING is cleared. */
+	if (test_bit_acquire(NF_FLOW_PENDING, &flow->flags))
 		return;
 
 	teardown = test_bit(NF_FLOW_TEARDOWN, &flow->flags);
 
 	if (nf_flow_has_expired(flow) ||
 	    nf_ct_is_dying(flow->ct) ||
@@ -615,8 +621,13 @@
 		if (test_bit(NF_FLOW_HW, &flow->flags)) {
 			if (!test_bit(NF_FLOW_HW_DYING, &flow->flags))
 				nf_flow_offload_del(flow_table, flow);
-			else if (test_bit(NF_FLOW_HW_DEAD, &flow->flags))
+			else if (test_bit(NF_FLOW_HW_DEAD, &flow->flags) &&
+				 !test_and_set_bit(NF_FLOW_PENDING, &flow->flags)) {
+				/* Exclude late work, including pre-unlink RCU readers.
+				 * Retirement keeps PENDING set through the RCU free.
+				 */
 				flow_offload_del(flow_table, flow);
+			}
 		} else {
 			flow_offload_del(flow_table, flow);
 		}
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -1147,6 +1147,12 @@
 	if (test_and_set_bit(NF_FLOW_PENDING, &flow->flags))
 		return NULL;
 
+	/* Recheck after acquiring ownership: hardware deletion is terminal. */
+	if (test_bit(NF_FLOW_HW_DYING, &flow->flags)) {
+		clear_bit(NF_FLOW_PENDING, &flow->flags);
+		return NULL;
+	}
+
 	offload = kmalloc(sizeof(struct flow_offload_work), GFP_ATOMIC);
 	if (!offload) {
 		clear_bit(NF_FLOW_PENDING, &flow->flags);
