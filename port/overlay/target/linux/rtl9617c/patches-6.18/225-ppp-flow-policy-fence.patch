 #define ppp_unlock(ppp)		do { ppp_recv_unlock(ppp); \
 				     ppp_xmit_unlock(ppp); } while (0)
 
+static struct net *ppp_flow_change_begin(struct ppp *ppp);
+static void ppp_flow_change_end(struct ppp *ppp, struct net *policy);
+
+/* All policy writers use the same two locks and generation as channel
+ * handoff. A new DIRECT recipe sees either the old policy/cookie or the
+ * new pair, never a stable cookie spanning the first policy publication.
+ */
+static void ppp_flow_set_flags(struct ppp *ppp, int flags)
+{
+	struct net *policy;
+	int cleared;
+
+	flags &= SC_FLAG_BITS;
+	ppp_lock(ppp);
+	cleared = ppp->flags & ~flags;
+	if (flags != ppp->flags) {
+		policy = ppp_flow_change_begin(ppp);
+#ifdef CONFIG_PPP_MULTILINK
+		if (!(ppp->flags & SC_MULTILINK) && (flags & SC_MULTILINK))
+			ppp->nextseq = 0;
+#endif
+		WRITE_ONCE(ppp->flags, flags);
+		ppp_flow_change_end(ppp, policy);
+	}
+	ppp_unlock(ppp);
+	if (cleared & SC_CCP_OPEN)
+		ppp_ccp_closed(ppp);
+}
+
+static void ppp_flow_set_npmode(struct ppp *ppp, int index, enum NPmode mode)
+{
+	struct net *policy = NULL;
+	bool ip = index == NP_IP || index == NP_IPV6;
+
+	ppp_lock(ppp);
+	if (ppp->npmode[index] != mode) {
+		if (ip)
+			policy = ppp_flow_change_begin(ppp);
+		WRITE_ONCE(ppp->npmode[index], mode);
+		if (ip)
+			ppp_flow_change_end(ppp, policy);
+	}
+	ppp_unlock(ppp);
+}
+
+#ifdef CONFIG_PPP_FILTER
+static void ppp_flow_set_filter(struct ppp *ppp, struct bpf_prog **which,
+				struct bpf_prog *filter)
+{
+	struct net *policy;
+	struct bpf_prog *old;
+
+	ppp_lock(ppp);
+	old = *which;
+	if (old != filter) {
+		policy = ppp_flow_change_begin(ppp);
+		WRITE_ONCE(*which, filter);
+		ppp_flow_change_end(ppp, policy);
+	}
+	ppp_unlock(ppp);
+	/* Both data-path locks have drained all old filter readers. Freeing
+	 * its program need not extend the synchronous admission fence. */
+	if (old && old != filter)
+		bpf_prog_destroy(old);
+}
+#endif
+
