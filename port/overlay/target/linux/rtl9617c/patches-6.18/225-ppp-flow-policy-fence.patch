@@ -1597,6 +1647,34 @@ static void ppp_dev_priv_destructor(struct net_device *dev)
 		ppp_destroy_interface(ppp);
 }
 
+static bool ppp_flow_policy_allows(const struct ppp *ppp, __be16 protocol)
+{
+	int index;
+
+	/* CCP_OPEN alone is negotiation, not a data-plane transformation.
+	 * A configured compressor is different: even before CCP_UP its state
+	 * can start tracking plain packets after CONFACK. Do not bypass it.
+	 */
+	if (READ_ONCE(ppp->flags) & (SC_MULTILINK | SC_LOOP_TRAFFIC |
+				   SC_COMP_TCP | SC_CCP_UP | SC_MUST_COMP))
+		return false;
+	if (READ_ONCE(ppp->xc_state) || READ_ONCE(ppp->rc_state))
+		return false;
+#ifdef CONFIG_PPP_FILTER
+	if (READ_ONCE(ppp->pass_filter) || READ_ONCE(ppp->active_filter))
+		return false;
+#endif
+	/* Only the flow's actual network protocol matters. A normal v4-only
+	 * PPPoE link may intentionally DROP IPv6, and vice versa. */
+	if (protocol == htons(ETH_P_IP))
+		index = NP_IP;
+	else if (protocol == htons(ETH_P_IPV6))
+		index = NP_IPV6;
+	else
+		return false;
+	return READ_ONCE(ppp->npmode[index]) == NPMODE_PASS;
+}
+
 static int ppp_fill_forward_path(struct net_device_path_ctx *ctx,
 				 struct net_device_path *path)
 {
@@ -1604,7 +1682,7 @@ static int ppp_fill_forward_path(struct net_device_path_ctx *ctx,
 	struct ppp_channel *chan;
 	struct channel *pch;
 
-	if (ppp->flags & SC_MULTILINK)
+	if (!ppp_flow_policy_allows(ppp, ctx->l3_proto))
 		return -EOPNOTSUPP;
 
 	pch = list_first_or_null_rcu(&ppp->channels, struct channel, clist);
@@ -3143,6 +3221,31 @@ ppp_output_wakeup(struct ppp_channel *chan)
  */
 
 /* Process the PPPIOCSCOMPRESS ioctl. */
+static void ppp_flow_replace_compressor(struct ppp *ppp, struct compressor *cp,
+				       void *state, bool transmit,
+				       struct compressor **old_cp, void **old_state)
+{
+	struct net *policy;
+
+	ppp_lock(ppp);
+	policy = ppp_flow_change_begin(ppp);
+	if (transmit) {
+		ppp->xstate &= ~SC_COMP_RUN;
+		*old_cp = ppp->xcomp;
+		*old_state = ppp->xc_state;
+		ppp->xcomp = cp;
+		WRITE_ONCE(ppp->xc_state, state);
+	} else {
+		ppp->rstate &= ~SC_DECOMP_RUN;
+		*old_cp = ppp->rcomp;
+		*old_state = ppp->rc_state;
+		ppp->rcomp = cp;
+		WRITE_ONCE(ppp->rc_state, state);
+	}
+	ppp_flow_change_end(ppp, policy);
+	ppp_unlock(ppp);
+}
+
 static int
 ppp_set_compress(struct ppp *ppp, struct ppp_option_data *data)
 {
@@ -3170,13 +3273,8 @@ ppp_set_compress(struct ppp *ppp, struct ppp_option_data *data)
 	if (data->transmit) {
 		state = cp->comp_alloc(ccp_option, data->length);
 		if (state) {
-			ppp_xmit_lock(ppp);
-			ppp->xstate &= ~SC_COMP_RUN;
-			ocomp = ppp->xcomp;
-			ostate = ppp->xc_state;
-			ppp->xcomp = cp;
-			ppp->xc_state = state;
-			ppp_xmit_unlock(ppp);
+			ppp_flow_replace_compressor(ppp, cp, state, true,
+						    &ocomp, &ostate);
 			if (ostate) {
 				ocomp->comp_free(ostate);
 				module_put(ocomp->owner);
@@ -3188,13 +3286,8 @@ ppp_set_compress(struct ppp *ppp, struct ppp_option_data *data)
 	} else {
 		state = cp->decomp_alloc(ccp_option, data->length);
 		if (state) {
-			ppp_recv_lock(ppp);
-			ppp->rstate &= ~SC_DECOMP_RUN;
-			ocomp = ppp->rcomp;
-			ostate = ppp->rc_state;
-			ppp->rcomp = cp;
-			ppp->rc_state = state;
-			ppp_recv_unlock(ppp);
+			ppp_flow_replace_compressor(ppp, cp, state, false,
+						    &ocomp, &ostate);
 			if (ostate) {
 				ocomp->decomp_free(ostate);
 				module_put(ocomp->owner);
@@ -3304,17 +3397,24 @@ ppp_ccp_closed(struct ppp *ppp)
 {
 	void *xstate, *rstate;
 	struct compressor *xcomp, *rcomp;
+	struct net *policy = NULL;
+	bool changing;
 
 	ppp_lock(ppp);
-	ppp->flags &= ~(SC_CCP_OPEN | SC_CCP_UP);
+	changing = (ppp->flags & SC_CCP_UP) || ppp->xc_state || ppp->rc_state;
+	if (changing)
+		policy = ppp_flow_change_begin(ppp);
+	WRITE_ONCE(ppp->flags, ppp->flags & ~(SC_CCP_OPEN | SC_CCP_UP));
 	ppp->xstate = 0;
 	xcomp = ppp->xcomp;
 	xstate = ppp->xc_state;
-	ppp->xc_state = NULL;
+	WRITE_ONCE(ppp->xc_state, NULL);
 	ppp->rstate = 0;
 	rcomp = ppp->rcomp;
 	rstate = ppp->rc_state;
-	ppp->rc_state = NULL;
+	WRITE_ONCE(ppp->rc_state, NULL);
+	if (changing)
+		ppp_flow_change_end(ppp, policy);
 	ppp_unlock(ppp);
 
 	if (xstate) {
