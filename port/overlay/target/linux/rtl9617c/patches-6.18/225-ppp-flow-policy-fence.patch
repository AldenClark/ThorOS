 	const struct net_device *dev;
 	u8			daddr[ETH_ALEN];
+	/* Inner network protocol, before VLAN/PPPoE encapsulation. Zero means
+	 * unspecified; protocol-sensitive devices must then decline bypass. */
+	__be16			l3_proto;
 
 	int			num_vlans;
 	struct {

