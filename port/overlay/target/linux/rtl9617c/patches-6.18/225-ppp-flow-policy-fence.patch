 		err = 0;
 		break;
 
@@ -929,7 +987,7 @@ static long ppp_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 			if (copy_to_user(argp, &npi, sizeof(npi)))
 				break;
 		} else {
-			WRITE_ONCE(ppp->npmode[i], npi.mode);
+			ppp_flow_set_npmode(ppp, i, npi.mode);
 			/* we may be able to transmit more packets now (??) */
