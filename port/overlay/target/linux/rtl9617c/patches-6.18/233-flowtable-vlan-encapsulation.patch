-static inline bool nf_flow_pppoe_proto(struct sk_buff *skb, __be16 *inner_proto)
+struct nf_flow_encap {
+	struct {
+		u16 id;
+		__be16 proto;
+	} encap[NF_FLOW_TABLE_ENCAP_MAX];
+	u32 offset;
+	u32 length;
+	u8 num;
+	__be16 proto;
