+/* The tuple is in wire order (outermost first), unlike the forward path. */
+static inline bool
+nf_flow_tuple_encap_valid(const struct flow_offload_tuple *tuple)
+{
+	unsigned int count = tuple->encap_num, i, vlans = 0;
+
+	if (count > NF_FLOW_TABLE_ENCAP_MAX || tuple->in_vlan_ingress >> count)
+		return false;
+
+	for (i = 0; i < count; i++) {
+		switch (tuple->encap[i].proto) {
+		case htons(ETH_P_8021Q):
+		case htons(ETH_P_8021AD):
+			if (++vlans > NF_FLOW_TABLE_VLAN_MAX ||
+			    tuple->encap[i].id > VLAN_VID_MASK)
+				return false;
+			break;
+		case htons(ETH_P_PPP_SES):
+			if (i + 1 != count || !tuple->encap[i].id ||
+			    (tuple->in_vlan_ingress & BIT(i)))
+				return false;
+			break;
+		default:
+			return false;
+		}
+	}
+	return true;
+}
