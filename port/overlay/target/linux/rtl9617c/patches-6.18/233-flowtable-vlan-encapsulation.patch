+
+/* Decode before matching or changing the skb. Metadata and inline VLANs share
+ * one depth budget; PPPoE must be the terminal L2 encapsulation. A failed pull
+ * can change linear storage but never publishes a partial lookup key.
+ */
+static inline bool nf_flow_encap_parse(struct sk_buff *skb,
+				     struct nf_flow_encap *encap)
 {
-	if (!pskb_may_pull(skb, ETH_HLEN + PPPOE_SES_HLEN))
+	struct nf_flow_encap next = {};
+	unsigned int vlans = 0, nhoff = skb_network_offset(skb);
+	__be16 proto = skb->protocol, ppp_proto;
+	struct pppoe_hdr *phdr;
+	struct vlan_hdr *vhdr;
+	unsigned int length;
+
+	/* NETDEV ingress starts at the network header. Do not accept an skb
+	 * layout that the subsequent pop/transmit path cannot consume. */
+	if (nhoff)
 		return false;
-
-	*inner_proto = __nf_flow_pppoe_proto(skb);
-
+	next.length = skb->len - nhoff;
+	if (skb_vlan_tag_present(skb)) {
+		if (skb->vlan_proto != htons(ETH_P_8021Q) &&
+		    skb->vlan_proto != htons(ETH_P_8021AD))
+			return false;
+		next.encap[next.num].id = skb_vlan_tag_get_id(skb);
+		next.encap[next.num++].proto = skb->vlan_proto;
+		vlans++;
+	}
+	while (proto == htons(ETH_P_8021Q) || proto == htons(ETH_P_8021AD)) {
+		if (++vlans > NF_FLOW_TABLE_VLAN_MAX ||
+		    next.length < VLAN_HLEN ||
+		    !pskb_may_pull(skb, nhoff + next.offset + VLAN_HLEN))
+			return false;
+		vhdr = (void *)(skb_network_header(skb) + next.offset);
+		next.encap[next.num].id = ntohs(vhdr->h_vlan_TCI) & VLAN_VID_MASK;
+		next.encap[next.num++].proto = proto;
+		proto = vhdr->h_vlan_encapsulated_proto;
+		next.offset += VLAN_HLEN;
+		next.length -= VLAN_HLEN;
+	}
+	if (proto == htons(ETH_P_PPP_SES)) {
+		if (next.length < PPPOE_SES_HLEN ||
+		    !pskb_may_pull(skb, nhoff + next.offset + PPPOE_SES_HLEN))
+			return false;
+		phdr = (void *)(skb_network_header(skb) + next.offset);
+		length = ntohs(phdr->length);
+		if (phdr->ver != 1 || phdr->type != 1 || phdr->code ||
+		    !phdr->sid || length < sizeof(ppp_proto) ||
+		    length > next.length - sizeof(*phdr))
+			return false;
+		memcpy(&ppp_proto, (u8 *)phdr + sizeof(*phdr), sizeof(ppp_proto));
+		switch (ppp_proto) {
+		case htons(PPP_IP):
+			proto = htons(ETH_P_IP);
+			break;
+		case htons(PPP_IPV6):
+			proto = htons(ETH_P_IPV6);
+			break;
+		default:
+			return false;
+		}
+		next.encap[next.num].id = ntohs(phdr->sid);
+		next.encap[next.num++].proto = htons(ETH_P_PPP_SES);
+		next.offset += PPPOE_SES_HLEN;
+		next.length = length - sizeof(ppp_proto);
+	}
+	if (proto != htons(ETH_P_IP) && proto != htons(ETH_P_IPV6))
+		return false;
+	next.proto = proto;
+	*encap = next;
 	return true;
 }
 
