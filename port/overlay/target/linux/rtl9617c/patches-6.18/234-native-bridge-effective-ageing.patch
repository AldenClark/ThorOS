+/* Native FDB entries must follow the bridge's actual hold_time(), not the
+ * generic switchdev ageing attribute. In a topology change the former is
+ * forward_delay, while __br_set_topology_change() advertises twice that
+ * value to generic switchdev. Every writer below is fenced before update;
+ * the driver's generation check makes this read part of its snapshot.
+ */
+int br_rtl9617c_fdb_hold_time(const struct net_device *br_dev,
+				unsigned long *ticks)
+{
+	const struct net_bridge *br;
+
+	ASSERT_RTNL();
+	if (!ticks || !netif_is_bridge_master(br_dev))
+		return -EINVAL;
+	br = netdev_priv(br_dev);
+	*ticks = READ_ONCE(br->topology_change) ?
+		READ_ONCE(br->forward_delay) : READ_ONCE(br->ageing_time);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(br_rtl9617c_fdb_hold_time);
