+/* Native UC switching does not implement these optional bridge policies.
+ * Snooping itself is intentionally allowed: every multicast/BUM/control
+ * frame is trapped, not copied after hardware replication, to the CPU.
+ */
+bool br_rtl9617c_l2_eligible(const struct net_device *master)
+{
+	const struct net_bridge_fdb_entry *fdb;
+	const struct net_bridge *br;
+	bool eligible = true;
+
+	ASSERT_RTNL();
+	if (!netif_is_bridge_master(master) || master->promiscuity)
+		return false;
+	br = netdev_priv(master);
+	if (br_opt_get(br, BROPT_MRP_ENABLED) ||
+	    br_opt_get(br, BROPT_CFM_ENABLED) ||
+	    br_opt_get(br, BROPT_MST_ENABLED) ||
+	    br_opt_get(br, BROPT_NEIGH_SUPPRESS_ENABLED) ||
+	    br_opt_get(br, BROPT_NO_LL_LEARN) ||
+	    br_opt_get(br, BROPT_VLAN_STATS_ENABLED) ||
+	    READ_ONCE(br->fdb_max_learned))
+		return false;
+
+	/* switchdev FDB replay does not carry the STATIC/STICKY lifetime bits.
+	 * Do not pin a user-managed dynamic row or turn a movable non-sticky
+	 * STATIC row into a sticky hardware row.  Only local and explicitly
+	 * sticky static entries have the required hardware lifetime semantics.
+	 * Ordinary HW-learned feedback is not policy.
+	 */
+	rcu_read_lock();
+	hlist_for_each_entry_rcu(fdb, &br->fdb_list, fdb_node) {
+		if (!test_bit(BR_FDB_LOCAL, &fdb->flags) &&
+		    ((test_bit(BR_FDB_ADDED_BY_USER, &fdb->flags) &&
+		      !test_bit(BR_FDB_STATIC, &fdb->flags)) ||
+		     (test_bit(BR_FDB_STATIC, &fdb->flags) &&
+		      !test_bit(BR_FDB_STICKY, &fdb->flags)))) {
+			eligible = false;
+			break;
+		}
+	}
+	rcu_read_unlock();
+	return eligible;
+}
+EXPORT_SYMBOL_GPL(br_rtl9617c_l2_eligible);
+
+bool br_rtl9617c_l2_port_eligible(const struct net_device *dev)
+{
+	const unsigned long allowed = BR_LEARNING | BR_LEARNING_SYNC | BR_FLOOD |
+		BR_MCAST_FLOOD | BR_BCAST_FLOOD | BR_PROMISC | BR_BPDU_GUARD |
+		BR_ROOT_BLOCK | BR_ADMIN_COST | BR_MULTICAST_FAST_LEAVE | BR_BPDU_FILTER;
+	const struct net_bridge_port *p;
+
+	ASSERT_RTNL();
+	p = br_port_get_rtnl(dev);
+	/* Non-default per-egress MTU programming is not implemented here;
+	 * smaller Linux port MTUs must retain is_skb_forwardable() in software.
+	 */
+	if (!p || READ_ONCE(dev->mtu) != ETH_DATA_LEN || (p->flags & ~allowed) ||
+	    rcu_access_pointer(p->backup_port) || p->backup_nhid)
+		return false;
+	/* The bridge's own promiscuity reference is not a userspace capture.
+	 * A second reference (e.g. tcpdump) must see traffic through the CPU.
+	 */
+	return dev->promiscuity <= !!(p->flags & BR_PROMISC);
+}
+EXPORT_SYMBOL_GPL(br_rtl9617c_l2_port_eligible);
