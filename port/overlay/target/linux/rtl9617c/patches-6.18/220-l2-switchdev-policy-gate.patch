+/* Pure route flowtable hooks cache previously authorized forwarding; they
+ * are not a bridge/ingress policy.  Ordinary nft/BPF/ebtables hooks, including
+ * an empty base chain or br_netfilter with its sysctl currently disabled,
+ * remain vetoes throughout their registration lifetime.  This also protects
+ * in-place rule replacement and a later br_netfilter sysctl change.
+ */
+static bool nf_hook_blocks_l2_switch(int pf, const struct nf_hook_ops *reg)
+{
+	const struct nf_flowtable *ft;
+
+	if (pf == NFPROTO_BRIDGE)
+		return true;
+	if (pf != NFPROTO_NETDEV &&
+	    !(pf == NFPROTO_INET && reg->hooknum == NF_INET_INGRESS))
+		return false;
+	if (pf == NFPROTO_NETDEV && reg->hooknum == NF_NETDEV_INGRESS &&
+	    reg->hook_ops_type == NF_HOOK_OP_NFT_FT && reg->priv) {
+		ft = reg->priv;
+		if (ft->type && reg->hook == ft->type->hook &&
+		    (ft->type->family == NFPROTO_IPV4 ||
+		     ft->type->family == NFPROTO_IPV6 ||
+		     ft->type->family == NFPROTO_INET))
+			return false;
+	}
+	return true;
