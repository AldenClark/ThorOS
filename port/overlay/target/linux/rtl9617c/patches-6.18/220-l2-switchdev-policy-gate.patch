+struct br_rtl9617c_learn_ctx {
+	struct net_bridge_port *port;
+	struct net_bridge_fdb_entry *fdb;
+	const unsigned char *addr;
+	bool changed;
+};
+
+/* Both hash_lock and the policy gate lock are held.  No notifications here:
+ * they could recurse into a policy gate or an unrelated driver's callback.
+ */
+static int br_rtl9617c_fdb_learn_publish(void *context)
+{
+	struct br_rtl9617c_learn_ctx *ctx = context;
+	struct net_bridge *br = ctx->port->br;
+	struct net_bridge_fdb_entry *fdb;
+
+	fdb = br_fdb_find(br, ctx->addr, 0);
+	if (fdb && (test_bit(BR_FDB_ADDED_BY_USER, &fdb->flags) ||
+		    test_bit(BR_FDB_STATIC, &fdb->flags) ||
+		    test_bit(BR_FDB_LOCAL, &fdb->flags) ||
+		    test_bit(BR_FDB_STICKY, &fdb->flags) ||
+		    test_bit(BR_FDB_LOCKED, &fdb->flags)))
+		return -EEXIST;
+	if (!fdb) {
+		fdb = fdb_create(br, ctx->port, ctx->addr, 0,
+				 BIT(BR_FDB_ADDED_BY_EXT_LEARN) | BIT(BR_FDB_OFFLOADED));
+		if (!fdb)
+			return -ENOMEM;
+		ctx->changed = true;
+	} else {
+		ctx->changed = READ_ONCE(fdb->dst) != ctx->port ||
+			!test_bit(BR_FDB_ADDED_BY_EXT_LEARN, &fdb->flags);
+		WRITE_ONCE(fdb->dst, ctx->port);
+		set_bit(BR_FDB_ADDED_BY_EXT_LEARN, &fdb->flags);
+		set_bit(BR_FDB_OFFLOADED, &fdb->flags);
+		WRITE_ONCE(fdb->updated, jiffies);
+		WRITE_ONCE(fdb->used, jiffies);
+	}
+	ctx->fdb = fdb;
+	return 0;
+}
+
+int br_rtl9617c_fdb_learn(const struct net_device *dev,
+			 const unsigned char *addr,
+			 struct rtl9617c_switch_guard *guard, u64 generation)
+{
+	struct br_rtl9617c_learn_ctx ctx = { .addr = addr };
+	int ret;
+
+	ASSERT_RTNL();
+	ctx.port = br_port_get_rtnl(dev);
+	if (!ctx.port)
+		return -ENODEV;
+	spin_lock_bh(&ctx.port->br->hash_lock);
+	ret = rtl9617c_switch_guard_publish(guard, generation,
+					    br_rtl9617c_fdb_learn_publish, &ctx);
+	if (!ret && ctx.changed)
+		fdb_notify(ctx.port->br, ctx.fdb, RTM_NEWNEIGH, false);
+	spin_unlock_bh(&ctx.port->br->hash_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(br_rtl9617c_fdb_learn);
+
+/* A scan/unoffload snapshot may predate a userspace replacement of a learned
+ * row.  The generic DEL_TO_BRIDGE operation checks only EXT_LEARNED and would
+ * delete the replacement too.  Revalidate ownership while holding hash_lock.
+ */
+bool br_rtl9617c_fdb_forget(const struct net_device *dev,
+			    const unsigned char *addr)
+{
+	struct net_bridge_fdb_entry *fdb;
+	struct net_bridge_port *p;
+	bool removed = false;
+
+	ASSERT_RTNL();
+	p = br_port_get_rtnl(dev);
+	if (!p)
+		return false;
+	spin_lock_bh(&p->br->hash_lock);
+	fdb = br_fdb_find(p->br, addr, 0);
+	if (fdb && READ_ONCE(fdb->dst) == p &&
+	    test_bit(BR_FDB_ADDED_BY_EXT_LEARN, &fdb->flags) &&
+	    !test_bit(BR_FDB_ADDED_BY_USER, &fdb->flags) &&
+	    !test_bit(BR_FDB_STATIC, &fdb->flags) &&
+	    !test_bit(BR_FDB_STICKY, &fdb->flags) &&
+	    !test_bit(BR_FDB_LOCKED, &fdb->flags) &&
+	    !test_bit(BR_FDB_LOCAL, &fdb->flags)) {
+		fdb_delete(p->br, fdb, false);
+		removed = true;
+	}
+	spin_unlock_bh(&p->br->hash_lock);
+	return removed;
+}
+EXPORT_SYMBOL_GPL(br_rtl9617c_fdb_forget);
