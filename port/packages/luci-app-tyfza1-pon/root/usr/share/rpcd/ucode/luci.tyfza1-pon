#!/usr/bin/env ucode
// SPDX-License-Identifier: GPL-2.0-or-later
'use strict';
import { readfile } from 'fs';

function read_value(path) {
	let text = readfile(path);
	return text == null ? null : trim(text);
}

function fields(text) {
	if (text == null)
		return null;
	let result = {};
	for (let token in split(trim(text), /\s+/)) {
		let position = index(token, '=');
		if (position > 0)
			result[substr(token, 0, position)] = substr(token, position + 1);
	}
	return result;
}

function status_live(status, now_ms) {
	if (type(status.pid) != 'int' || status.pid <= 0 || type(status.updated_ms) != 'int')
		return false;
	// /proc/uptime is truncated to centiseconds; compare at the same resolution.
	let updated_ms = status.updated_ms - status.updated_ms % 10;
	let process = readfile('/proc/' + status.pid + '/stat');
	let end = process != null ? index(process, ') ') : -1;
	let state = end >= 0 ? split(substr(process, end + 2), ' ') : [];
	return length(state) > 19 && state[0] != 'Z' && state[0] != 'X' &&
		state[19] == status.process_start && now_ms >= updated_ms && now_ms - updated_ms < 5000;
}

function omci_status(now_ms) {
	let status = fields(readfile('/var/run/pon-omci'));
	if (status == null)
		return null;
	status.pid = +status.pid;
	status.updated_ms = +status.updated_ms;
	status.live = status_live(status, now_ms);
	return status;
}

function oam_ports(now_ms) {
	let ports = [];
	for (let llid = 0; llid < 32; llid++) {
		let text = readfile('/var/run/pon-oam/llid-' + llid + '.json');
		if (text == null)
			continue;
		let status;
		try { status = json(text); }
		catch (e) { continue; }
		if (type(status) != 'object' || type(status.pid) != 'int' || status.pid <= 0)
			continue;
		status.llid_index = llid;
		status.live = status_live(status, now_ms);
		if (!status.live) {
			status.registered = false;
			status.auth_state = null;
			status.discovery_stable = false;
		}
		push(ports, status);
	}
	return ports;
}

function snapshot(extended) {
	const device = '/sys/bus/platform/devices/4f5500000.pon/';
	const now_ms = +split(trim(readfile('/proc/uptime')), ' ')[0] * 1000;
	const data_path = readfile(device + 'data_path');
	const serdes = fields(readfile(device + 'serdes'));
	let data = {
		identity: {
			onu_mac: read_value(device + 'onu_mac'),
			serial_number: read_value(device + 'active_serial_number')
		},
		service: fields(readfile('/var/run/pon-service')),
		activation: fields(readfile(device + 'activation')),
		data_path: fields(data_path == null ? null : split(data_path, '\n')[0]),
		data_path_raw: data_path,
		omci: omci_status(now_ms),
		serdes: serdes,
		bosa: fields(readfile(device + 'bosa')),
		mac: fields(readfile(device + 'mac')),
		mpcp: fields(readfile(device + 'mpcp')),
		optical: fields(readfile(device + 'optical')),
		oam_ports: serdes != null && substr(serdes.mode || '', 0, 4) == 'epon' ? oam_ports(now_ms) : [],
		queried_at: time()
	};
	if (extended) {
		data.state = fields(readfile(device + 'state'));
		data.traffic = fields(readfile(device + 'traffic'));
		data.fe = fields(readfile(device + 'fe'));
		data.fec = fields(readfile(device + 'fec'));
		data.puc = readfile(device + 'puc');
		data.pdc = readfile(device + 'pdc');
		data.llids = readfile(device + 'llid_table');
		data.deepq = fields(readfile('/sys/bus/platform/devices/4f4300000.ethernet/pon_deepq'));
	}
	return data;
}

const methods = {
	status: { call: function() { return snapshot(false); } },
	diagnostics: { call: function() { return snapshot(true); } }
};

return { 'luci.tyfza1-pon': methods };
